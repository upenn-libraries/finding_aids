<section class="pl-padding-y-2xl">
  <div class="pl-viewport-margins">
    <h2 class="pl-margin-b-m"><%= t('homepage.collection_guides.heading') %></h2>
    <p class="pl-line-length pl-margin-b-xl">
      <%= t('homepage.collection_guides.intro_html',
            browse_all_link: link_to(t('homepage.collection_guides.browse_all'),
                                    search_catalog_path(q: '', search_field: 'all_fields'))) %>
    </p>

    <ol class="pl-cards fa-cards--capped">
      <% @guides.each do |guide| %>
        <li class="pl-card">
          <h3 class="pl-card__heading">
            <%= link_to guide.title, guide_url(guide), class: 'pl-card__link' %>
          </h3>
          <p class="pl-card__description"><%= guide.repository %></p>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<div class="fa-regional-partnership__body pl-padding-y-2xl">
  <div class="pl-viewport-margins">
    <h2 id="regional-partnership-heading" class="pl-margin-b-m"><%= t('homepage.regional_partnership.heading') %></h2>
    <p class="pl-line-length pl-margin-b-xl">
      <%= t('homepage.regional_partnership.intro_html',
            browse_all_link: link_to(t('homepage.regional_partnership.browse_all'),
                                     helpers.facet_catalog_path('repository_ssi'),
                                     data: { blacklight_modal: 'trigger', turbo: false })) %>
    </p>

    <ol class="pl-cards fa-cards--capped">
      <% @repos.each do |repo| %>
        <li class="pl-card">
          <h3 class="pl-card__heading">
            <%= link_to repo.name, repository_facet_url(repo.name), class: 'pl-card__link' %>
          </h3>
          <p class="pl-card__description"><%= t('homepage.regional_partnership.guides_count',
                                              count: number_with_delimiter(repo.count)) %></p>
        </li>
      <% end %>
    </ol>
  </div>
</div>

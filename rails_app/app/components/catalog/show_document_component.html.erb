<%# Override Blacklight 9.0.0 template to implement custom layout %>
<div class="document-main-section pl-margin-b-3xl"
     data-controller="guide-navigation"
     data-action="toggle->guide-navigation#handleDetailsToggle:capture click->guide-navigation#handleTocClick">
  <div class="pl-padding-y-2xl" style="background: var(--pl-color-bg-subtle);">
    <div class="pl-viewport-margins">

      <div class="fa-guide-header">
        <div class="fa-guide-header__hero">
          <div class="fa-guide-header__intro">

            <h1 id="guide-title" class="pl-margin-b-l"><%= presenter.heading %></h1>
           <% if abstract %>
              <p style="font-size: var(--pl-font-size-l);" class="pl-line-length"><%= abstract %></p>
          <% end %>
          </div>

          <aside class="fa-guide-header__institution pl-callout" aria-label="<%= t('show.aside.aria_label') %>">
            <p class="fa-small-name pl-margin-b-2xs"><%= t('show.aside.held_at') %></p>
            <p class="pl-margin-b-m"><%= repository %></p>
            <% if document.extract(:access_restrictions) %>
              <p class="fa-small-name pl-margin-b-2xs"><%= t('show.aside.access') %></p>
              <div class="pl-margin-b-m"><%= document.extract(:access_restrictions) %></div>
            <% end %>

            <a href="#contact" class="pl-button pl-button--accent"><%=t('show.aside.contact') %></a>
          </aside>
        </div>
        <div class="fa-guide-header__strip">
          <%= render ShowMetadataFieldsComponent.new(fields: collection_overview,
                                                     dl_class: 'fa-metadata',
                                                     dt_class: 'fa-small-name',
                                                     wrapper_tag: 'div') %>
        </div>
      </div>
    </div>
  </div>

  <div class="fa-guide-layout pl-viewport-margins pl-margin-y-2xl fa-guide-layout--with-toc" style="max-width: 100%">
    <nav id="guide-toc" class="fa-toc" aria-label="Table of contents">
      <%= render(TableOfContentsComponent.new(document: @document, presenter: presenter, entries: inventory_entries, depth: 1)) %>
    </nav>
    <div class="fa-guide-content">
      <div id="description-sections" class="pl-margin-b-2xl">
        <div class="fa-section-header">
          <div>
            <h2 id="description"><%= t("show.sections.description.header") %></h2>
            <p class="pl-font-size-l"><%= t("show.sections.description.guide") %></p>
          </div>
          <button id="toggle-description" type="button" class="pl-button"
                  data-pl-expand-label="<%= t('show.buttons.accordion_control.expand') %>"
                  data-pl-collapse-label="<%= t('show.buttons.accordion_control.collapse') %>"
                  data-pl-accordion-toggle="description-accordion">
          </button>
        </div>
          <%= render(DescriptionComponent.new(document: document, presenter: @presenter, id: 'description-accordion')) %>
      </div>
      <div id="inventory-sections" class="pl-margin-b-2xl">
        <div class="fa-section-header">
          <div>
            <h2 id="inventory"><%= t("show.sections.inventory.header") %></h2>
            <p class="pl-font-size-l"><%= t("show.sections.inventory.guide") %></p>
          </div>
          <button id="toggle-inventory" type="button" class="pl-button"
                  data-pl-expand-label="<%= t('show.buttons.accordion_control.expand') %>"
                  data-pl-collapse-label="<%= t('show.buttons.accordion_control.collapse') %>"
                  data-pl-accordion-toggle="inventory-accordion">
          </button>
        </div>
        <turbo-frame id="inventory-frame" src="<%= details_inventory_path(@document.id) %>">
          <pennlibs-accordion class="pl-flex pl-flex-col pl-gap-m" id="inventory-accordion">
              <% inventory_entries.each_with_index do |entry, i| %>
                <details class="fa-guide__details">
                  <summary>
                    <h3 id="<%= entry.id(index: i + 1) %>"><%= entry_presenter.heading(entry) %></h3>
                  </summary>
                  <div>
                    <p class="placeholder-glow mb-2">
                      <span class="placeholder col-7"></span>
                      <span class="placeholder col-4"></span>
                      <span class="placeholder col-4"></span>
                      <span class="placeholder col-6"></span>
                      <span class="placeholder col-8"></span>
                    </p>
                  </div>
                </details>
              <% end %>
          </pennlibs-accordion>
        </turbo-frame>
      </div>
      <section>
        <h2 id="contact"><%= t('show.sections.contact.header') %></h2>
        <p style="font-size: var(--pl-font-size-l);" class="pl-line-length pl-margin-b-m">
          <%= t("show.sections.contact.guide_html", repository: @document.repository) %>
        </p>
        <%= render ShowMetadataFieldsComponent.new(fields: contact, dl_class: 'pl-dl pl-margin-t-l') %>
      </section>
    </div>
  </div>
</div>
